# =====================================================================
# ORTAM DEĞİŞKENLERİ ŞABLONU
# Bu dosya git'e GİDER, ama içinde gerçek değer YOKTUR; sadece hangi
# değişkenlerin gerektiğini gösterir.
#
# Kullanım: bu dosyanın kopyasını ".env.local" adıyla oluştur ve
# değerleri Supabase panelinden doldur. .env.local git'e GİTMEZ
# (.gitignore'da), çünkü gerçek değerler orada.
#
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gönderilen JavaScript'in
# içine gömülür, yani HERKES görebilir. Bu yüzden buraya sadece
# "herkese açık olması zaten tasarlanmış" değerler konur.
# Gizli anahtarlar (secret key, veritabanı şifresi) ASLA NEXT_PUBLIC_ almaz.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_ ile başlar)
# Herkese açık olabilir: tek başına bir yetkisi yok, ne görebileceğine RLS karar veriyor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Sitenin tam adresi, sonda "/" olmadan (sitemap, paylaşım önizlemesi, Google işletme bilgisi).
# Geliştirmede boş bırakılabilir (http://localhost:3000 kullanılır). Yayında ŞART.
NEXT_PUBLIC_SITE_URL=

# Site modu (ayrıntı: src/lib/siteMode.ts). Tanınmayan bir değer yazılırsa site AÇILMAZ (bilerek).
#   boş / production → gerçek salon sitesi
#   staging          → yayın öncesi deneme: noindex, "deneme" şeridi, sadece "TEST…" adlı randevu
#   demo             → portföy demosu: noindex, "demo" şeridi, ad/telefon sunucuda uydurulur, mail yok
SITE_MODE=

# --- Yeni randevu e-postası (Resend) ---
# Resend → API Keys → Create API Key (izin: "Sending access"). GİZLİ: NEXT_PUBLIC_ ALMAZ.
# Boş bırakılırsa randevular yine kaydedilir, sadece mail gitmez.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Bildirimin gideceği adres. Resend'de alan adı doğrulanana kadar sadece
# Resend hesabını açtığın e-posta adresi çalışır.
BOOKING_NOTIFY_TO=
# İsteğe bağlı. Boşsa "<site.emailFromName> <onboarding@resend.dev>" kullanılır (src/lib/site.ts).
BOOKING_NOTIFY_FROM=

# --- Sadece SITE_MODE=demo: "Demo olarak gir" düğmesinin kullandığı ortak hesap ---
# Hesap ve kilitleri: supabase/demo/demo_admin.sql. GİZLİ: NEXT_PUBLIC_ ALMAZ.
# Gerçek bir salon sitesinde BOŞ bırakılır.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
