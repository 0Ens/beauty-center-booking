# =====================================================================
# ORTAM DEĞİŞKENLERİ ŞABLONU
# Bu dosya git'e GİDER, ama içinde gerçek değer YOKTUR; sadece hangi
# değişkenlerin gerektiğini gösterir.
#
# Kullanım: bu dosyanın kopyasını ".env.local" adıyla oluştur ve
# değerleri Supabase panelinden doldur. .env.local git'e GİTMEZ
# (.gitignore'da), çünkü gerçek değerler orada.
#
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gönderilen JavaScript'in
# içine gömülür, yani HERKES görebilir. Bu yüzden buraya sadece
# "herkese açık olması zaten tasarlanmış" değerler konur.
# Gizli anahtarlar (secret key, veritabanı şifresi) ASLA NEXT_PUBLIC_ almaz.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_ ile başlar)
# Herkese açık olabilir: tek başına bir yetkisi yok, ne görebileceğine RLS karar veriyor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
